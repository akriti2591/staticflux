{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "node"
    ],
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "packages/*/src",
    "tooling/*/src",
    "apps/instaflow/src",
    "apps/instaflow/bench",
    "apps/instaflow/dev"
  ],
  "exclude": [
    "apps/instaflow/bench/**/dist"
  ]
}
