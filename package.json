{
  "name": "staticflux",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:boundaries": "depcruise packages tooling apps --config .dependency-cruiser.cjs",
    "size": "size-limit",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm lint:boundaries && pnpm size"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "happy-dom": "21.0.4",
    "dependency-cruiser": "18.7.0",
    "size-limit": "14.3.0",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/node": "^22.0.0"
  }
}
