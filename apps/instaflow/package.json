{
  "name": "@instaflow/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Instaflow: a canvas-first design, video and flow editor on StaticFlux (docs/instaflow). M1 in progress.",
  "license": "MIT",
  "staticflux": {
    "layer": "app"
  },
  "exports": {
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./versioning": {
      "types": "./dist/versioning/index.d.ts",
      "import": "./dist/versioning/index.js"
    },
    "./versioning/ui": {
      "types": "./dist/versioning/ui.d.ts",
      "import": "./dist/versioning/ui.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./elements/panel": {
      "types": "./dist/elements/panel.d.ts",
      "import": "./dist/elements/panel.js"
    },
    "./library": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./library/ui": {
      "types": "./dist/library/ui.d.ts",
      "import": "./dist/library/ui.js"
    },
    "./lenses": {
      "types": "./dist/lenses/index.d.ts",
      "import": "./dist/lenses/index.js"
    },
    "./lenses/ui": {
      "types": "./dist/lenses/ui.d.ts",
      "import": "./dist/lenses/ui.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./tools/transform-bar": {
      "types": "./dist/tools/transform-bar.d.ts",
      "import": "./dist/tools/transform-bar.js"
    },
    "./repeat": {
      "types": "./dist/repeat/index.d.ts",
      "import": "./dist/repeat/index.js"
    },
    "./repeat/panel": {
      "types": "./dist/repeat/panel.d.ts",
      "import": "./dist/repeat/panel.js"
    },
    "./a11y": {
      "types": "./dist/a11y/index.d.ts",
      "import": "./dist/a11y/index.js"
    },
    "./home": {
      "types": "./dist/home/index.d.ts",
      "import": "./dist/home/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    },
    "./export/panel": {
      "types": "./dist/export/panel.d.ts",
      "import": "./dist/export/panel.js"
    }
  },
  "scripts": {
    "bench:build": "vite build -c bench/sequencing/vite.config.ts",
    "bench:run": "node ../../packages/testkit/dist/gpu-cli.js bench/sequencing/dist index.html",
    "ime-check": "node src/text/ime-check/serve.mjs",
    "dev": "vite -c dev/studio/vite.config.ts",
    "smoke": "node test/smoke/studio.smoke.mjs",
    "smoke:home": "node test/smoke/home.smoke.mjs"
  },
  "dependencies": {
    "@staticflux/a11y": "workspace:*",
    "@staticflux/blob": "workspace:*",
    "@staticflux/capabilities": "workspace:*",
    "@staticflux/config": "workspace:*",
    "@staticflux/core": "workspace:*",
    "@staticflux/document": "workspace:*",
    "@staticflux/i18n": "workspace:*",
    "@staticflux/platform": "workspace:*",
    "@staticflux/stage": "workspace:*",
    "@staticflux/surface": "workspace:*",
    "@staticflux/worker": "workspace:*",
    "@staticflux/kit": "workspace:*",
    "@staticflux/ui": "workspace:*",
    "@lit/context": "1.1.6",
    "lit": "3.3.3",
    "@staticflux/gate": "workspace:*",
    "@staticflux/shell": "workspace:*",
    "@staticflux/loader": "workspace:*",
    "@staticflux/router": "workspace:*",
    "@staticflux/storage": "workspace:*"
  },
  "devDependencies": {
    "@staticflux/runtime": "workspace:*",
    "@staticflux/testkit": "workspace:*",
    "fast-check": "4.10.2",
    "harfbuzzjs": "1.6.4",
    "vite": "8.3.5"
  }
}
