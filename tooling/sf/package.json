{
  "name": "@staticflux/sf",
  "version": "0.1.0",
  "description": "StaticFlux CLI: dependency-graph checks, budget reports, error catalog and manifest generation.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sf": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-helpers.ts",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "staticflux": {
    "layer": "tooling"
  },
  "dependencies": {
    "@staticflux/core": "workspace:*",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@staticflux/loader": "workspace:*",
    "@staticflux/router": "workspace:*",
    "@staticflux/runtime": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akriti2591/staticflux.git",
    "directory": "tooling/sf"
  },
  "homepage": "https://akriti2591.github.io/staticflux/",
  "bugs": {
    "url": "https://github.com/akriti2591/staticflux/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "staticflux",
    "typescript",
    "framework",
    "client-side"
  ],
  "engines": {
    "node": ">=22"
  }
}
