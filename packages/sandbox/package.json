{
  "name": "@staticflux/sandbox",
  "version": "0.1.0",
  "description": "Isolated hosting of untrusted plugins (iframe/worker) that can only call declared capabilities.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "staticflux": {
    "layer": "vertical"
  },
  "dependencies": {
    "@staticflux/core": "workspace:*",
    "@staticflux/capabilities": "workspace:*",
    "@staticflux/worker": "workspace:*"
  }
}
