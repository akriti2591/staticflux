{
  "name": "@staticflux/testkit",
  "version": "0.1.0",
  "description": "Testing toolkit: test injector, deterministic clocks/schedulers, fake session, re-exported package fakes, shared contract suites, GPU and media fakes, SSIM image comparison, golden render snapshots and a real-GPU (Chromium) runner.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "import": "./dist/a11y.js"
    }
  },
  "bin": {
    "sf-gpu-run": "./dist/gpu-cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-helpers.ts",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "staticflux": {
    "layer": "tooling"
  },
  "dependencies": {
    "@staticflux/core": "workspace:*",
    "@staticflux/runtime": "workspace:*",
    "@staticflux/auth": "workspace:*",
    "@staticflux/data": "workspace:*",
    "@staticflux/platform": "workspace:*",
    "@staticflux/storage": "workspace:*",
    "@staticflux/worker": "workspace:*",
    "@staticflux/router": "workspace:*",
    "@staticflux/urlstate": "workspace:*",
    "@staticflux/document": "workspace:*",
    "fast-check": "4.10.2",
    "@staticflux/blob": "workspace:*",
    "@staticflux/ui": "workspace:*",
    "@staticflux/stage": "workspace:*",
    "@staticflux/surface": "workspace:*"
  },
  "devDependencies": {
    "@staticflux/browser-test": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akriti2591/staticflux.git",
    "directory": "packages/testkit"
  },
  "homepage": "https://akriti2591.github.io/staticflux/",
  "bugs": {
    "url": "https://github.com/akriti2591/staticflux/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "staticflux",
    "typescript",
    "framework",
    "client-side"
  ],
  "engines": {
    "node": ">=22"
  }
}
