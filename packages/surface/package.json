{
  "name": "@staticflux/surface",
  "version": "0.1.0",
  "description": "Render surfaces (Canvas2D/WebGL/WebGPU/HTML-in-Canvas), frame loop, OffscreenCanvas transfer, input forwarding; GPU raster backend port, text input (EditContext / hidden textarea), image scaling and PNG.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./input-ring": {
      "types": "./dist/input-ring.d.ts",
      "import": "./dist/input-ring.js"
    },
    "./text-input": {
      "types": "./dist/text-input.d.ts",
      "import": "./dist/text-input.js"
    },
    "./raster": {
      "types": "./dist/raster.d.ts",
      "import": "./dist/raster.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-helpers.ts",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "staticflux": {
    "layer": "ui"
  },
  "dependencies": {
    "@staticflux/core": "workspace:*",
    "@staticflux/platform": "workspace:*",
    "@staticflux/runtime": "workspace:*",
    "@staticflux/worker": "workspace:*"
  },
  "devDependencies": {
    "@staticflux/testkit": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akriti2591/staticflux.git",
    "directory": "packages/surface"
  },
  "homepage": "https://akriti2591.github.io/staticflux/",
  "bugs": {
    "url": "https://github.com/akriti2591/staticflux/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "staticflux",
    "typescript",
    "framework",
    "client-side"
  ],
  "engines": {
    "node": ">=22"
  }
}
