{
  "name": "@staticflux/runtime",
  "version": "0.1.0",
  "description": "App supervisor, app & feature lifecycles, resource manager, frame scheduler, memory budgets.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-helpers.ts",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "staticflux": {
    "layer": "runtime"
  },
  "dependencies": {
    "@staticflux/core": "workspace:*",
    "@staticflux/storage": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akriti2591/staticflux.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://akriti2591.github.io/staticflux/",
  "bugs": {
    "url": "https://github.com/akriti2591/staticflux/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "staticflux",
    "typescript",
    "framework",
    "client-side"
  ],
  "engines": {
    "node": ">=22"
  }
}
