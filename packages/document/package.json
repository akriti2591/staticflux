{
  "name": "@staticflux/document",
  "version": "0.1.0",
  "description": "ECS document model (v1, Yjs) and DocumentCRDT v2, DocumentRepo, versioned components (v2, Loro adapter).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    },
    "./loro-crdt": {
      "types": "./dist/loro-crdt.d.ts",
      "import": "./dist/loro-crdt.js"
    },
    "./render-projection": {
      "types": "./dist/render-projection.d.ts",
      "import": "./dist/render-projection.js"
    },
    "./spatial-index": {
      "types": "./dist/spatial-index.d.ts",
      "import": "./dist/spatial-index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts",
    "!src/**/test-helpers.ts",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "staticflux": {
    "layer": "vertical"
  },
  "dependencies": {
    "@staticflux/core": "workspace:*",
    "@staticflux/worker": "workspace:*",
    "loro-crdt": "1.17.1",
    "rbush": "4.0.1",
    "yjs": "13.6.33"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akriti2591/staticflux.git",
    "directory": "packages/document"
  },
  "homepage": "https://akriti2591.github.io/staticflux/",
  "bugs": {
    "url": "https://github.com/akriti2591/staticflux/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "staticflux",
    "typescript",
    "framework",
    "client-side"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/rbush": "4.0.0"
  }
}
