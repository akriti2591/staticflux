{
  "name": "@staticflux/ui",
  "version": "0.1.0",
  "description": "Lit integration: components with declared deps, MobX controller, scope elements.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "staticflux": {
    "layer": "ui"
  },
  "dependencies": {
    "@staticflux/core": "workspace:*",
    "@staticflux/runtime": "workspace:*",
    "lit": "3.3.3",
    "@lit/context": "1.1.6"
  }
}
